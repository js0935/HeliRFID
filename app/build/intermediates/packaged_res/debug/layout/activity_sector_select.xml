<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:text="分區選取寫入"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_gravity="center"
        android:layout_marginBottom="12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/txtSectorInfo"
        android:text="請掃描卡片以載入 Sector 列表"
        android:textSize="12sp"
        android:textColor="@color/text_body"
        android:fontFamily="monospace"
        android:background="@color/card_bg"
        android:padding="8dp"
        android:layout_marginBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnSelectAll"
            android:text="全選"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/btn_blue"/>

        <Button
            android:id="@+id/btnDeselectAll"
            android:text="取消全選"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/btn_red"/>

    </LinearLayout>

    <ListView
        android:id="@+id/listSectors"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="8dp"/>

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <Button
            android:id="@+id/btnReadSelected"
            android:text="讀取選取區塊"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/btn_green"/>

        <Button
            android:id="@+id/btnWriteSelected"
            android:text="寫入選取區塊"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/btn_orange"/>

    </LinearLayout>

</LinearLayout>
