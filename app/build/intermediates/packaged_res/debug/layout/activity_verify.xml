<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:text="寫入前驗證"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_gravity="center"
            android:layout_marginBottom="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:text="手動驗證"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:hint="UID (hex, 不含空格)">

            <EditText
                android:id="@+id/editVerifyUid"
                android:inputType="text"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:textColor="@color/text_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:hint="BCC (hex, 選擇性)">

            <EditText
                android:id="@+id/editVerifyBcc"
                android:inputType="text"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:textColor="@color/text_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:hint="ATQA (4 hex, 選擇性)">

            <EditText
                android:id="@+id/editVerifyAtqa"
                android:inputType="text"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:textColor="@color/text_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="SAK (2 hex, 選擇性)">

            <EditText
                android:id="@+id/editVerifySak"
                android:inputType="text"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:textColor="@color/text_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/btnVerify"
            android:text="驗證"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:backgroundTint="@color/btn_blue"/>

        <TextView
            android:text="快速偵測 (掃描卡片後使用)"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <Button
            android:id="@+id/btnQuickVerify"
            android:text="讀取卡片資訊並驗證"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:backgroundTint="@color/btn_green"
            app:cornerRadius="8dp"/>

        <TextView
            android:id="@+id/txtVerifyResult"
            android:text=""
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textColor="@color/text_body"
            android:background="@color/card_bg"
            android:padding="12dp"
            android:minLines="8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

    </LinearLayout>

</ScrollView>
