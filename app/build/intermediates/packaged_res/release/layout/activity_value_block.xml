<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:text="數值區塊增減"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_gravity="center"
            android:layout_marginBottom="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:hint="Sector">

            <EditText
                android:id="@+id/editVbSector"
                android:inputType="number"
                android:textSize="14sp"
                android:textColor="@color/text_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:hint="Block (相對, 0-3)">

            <EditText
                android:id="@+id/editVbBlock"
                android:inputType="number"
                android:textSize="14sp"
                android:textColor="@color/text_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:hint="數值">

            <EditText
                android:id="@+id/editVbValue"
                android:inputType="number"
                android:textSize="14sp"
                android:textColor="@color/text_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:hint="金鑰 A (12 hex, 預設 FFFFFFFFFFFF)">

            <EditText
                android:id="@+id/editVbKeyA"
                android:text="FFFFFFFFFFFF"
                android:inputType="text"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:textColor="@color/text_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btnVbRead"
                android:text="讀取"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/btn_blue"/>

            <Button
                android:id="@+id/btnVbInc"
                android:text="遞增"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/btn_green"/>

            <Button
                android:id="@+id/btnVbDec"
                android:text="遞減"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/btn_red"/>

            <Button
                android:id="@+id/btnVbWrite"
                android:text="寫入"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/btn_orange"/>

        </LinearLayout>

        <TextView
            android:id="@+id/txtVbResult"
            android:text="請掃描卡片並設定 Sector/Block"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:textColor="@color/text_body"
            android:background="@color/card_bg"
            android:padding="12dp"
            android:minLines="6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

    </LinearLayout>

</ScrollView>
