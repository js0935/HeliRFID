<?xml version="1.0" encoding="utf-8"?>
<!--
  HeliRFID - 智慧門禁管理系統
  禾秝軟體開發團隊 / 代碼：洪俊士 / 版本：4.0.1
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.helirfid"
    android:versionCode="11"
    android:versionName="4.3.0" >

    <uses-sdk
        android:minSdkVersion="23"
        android:targetSdkVersion="34" />

    <uses-feature
        android:name="android.hardware.nfc"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.usb.host"
        android:required="false" />

    <uses-permission android:name="android.permission.NFC" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />

    <permission
        android:name="com.helirfid.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.helirfid.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />

    <application
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:extractNativeLibs="false"
        android:icon="@mipmap/ic_launcher"
        android:label="HeliRFID 專業版"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme" >
        <activity
            android:name="com.helirfid.SplashActivity"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.helirfid.MainActivity"
            android:exported="true"
            android:launchMode="singleTask" >
            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:scheme="vnd.android.nfc" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.nfc.action.TECH_DISCOVERED" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.nfc.action.TAG_DISCOVERED" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <meta-data
                android:name="android.nfc.action.TECH_DISCOVERED"
                android:resource="@xml/nfc_tech_filter" />
        </activity>
        <activity
            android:name="com.helirfid.MemoryDumpActivity"
            android:exported="true"
            android:parentActivityName="com.helirfid.MainActivity" />
        <activity
            android:name="com.helirfid.WriteActivity"
            android:exported="true"
            android:parentActivityName="com.helirfid.MainActivity" />
        <activity
            android:name="com.helirfid.TagInfoActivity"
            android:exported="true"
            android:parentActivityName="com.helirfid.MainActivity" />
        <activity
            android:name="com.helirfid.ToolsActivity"
            android:exported="true"
            android:parentActivityName="com.helirfid.MainActivity" />
        <activity
            android:name="com.helirfid.KeyManagementActivity"
            android:exported="true"
            android:parentActivityName="com.helirfid.ToolsActivity" />
        <activity
            android:name="com.helirfid.DiffToolActivity"
            android:exported="true"
            android:parentActivityName="com.helirfid.ToolsActivity" />
        <activity
            android:name="com.helirfid.LogViewerActivity"
            android:exported="true"
            android:parentActivityName="com.helirfid.ToolsActivity" />
        <activity
            android:name="com.helirfid.CloneActivity"
            android:exported="true"
            android:parentActivityName="com.helirfid.MemoryDumpActivity" />
        <activity
            android:name="com.helirfid.ApduConsoleActivity"
            android:exported="true"
            android:parentActivityName="com.helirfid.ToolsActivity" />
        <activity
            android:name="com.helirfid.MagicCardActivity"
            android:exported="true"
            android:parentActivityName="com.helirfid.ToolsActivity" />
        <activity
            android:name="com.helirfid.DumpEditorActivity"
            android:exported="true"
            android:parentActivityName="com.helirfid.ToolsActivity" />
        <activity
            android:name="com.helirfid.UidGeneratorActivity"
            android:exported="true"
            android:parentActivityName="com.helirfid.ToolsActivity" />
        <activity
            android:name="com.helirfid.ShareActivity"
            android:exported="true"
            android:parentActivityName="com.helirfid.ToolsActivity" />
        <activity
            android:name="com.helirfid.DataConverterActivity"
            android:exported="true"
            android:parentActivityName="com.helirfid.ToolsActivity" />
        <activity
            android:name="com.helirfid.ScanLogActivity"
            android:exported="true"
            android:parentActivityName="com.helirfid.ToolsActivity" />
        <activity
            android:name="com.helirfid.ValueBlockActivity"
            android:exported="true"
            android:parentActivityName="com.helirfid.ToolsActivity" />
        <activity
            android:name="com.helirfid.AdvancedKeyManagerActivity"
            android:exported="true"
            android:parentActivityName="com.helirfid.ToolsActivity" />
        <activity
            android:name="com.helirfid.NfcVActivity"
            android:exported="true"
            android:parentActivityName="com.helirfid.ToolsActivity" />
        <activity
            android:name="com.helirfid.HceActivity"
            android:exported="true"
            android:parentActivityName="com.helirfid.ToolsActivity" />

        <service
            android:name="com.helirfid.HceSimulationService"
            android:exported="true"
            android:permission="android.permission.BIND_NFC_SERVICE" >
            <intent-filter>
                <action android:name="android.nfc.cardemulation.action.HOST_APDU_SERVICE" />
            </intent-filter>

            <meta-data
                android:name="android.nfc.cardemulation.host_apdu_service"
                android:resource="@xml/apdu_service" />
        </service>

        <activity
            android:name="com.helirfid.DesfireActivity"
            android:exported="true"
            android:parentActivityName="com.helirfid.ToolsActivity" />
        <activity
            android:name="com.helirfid.FelicaActivity"
            android:exported="true"
            android:parentActivityName="com.helirfid.ToolsActivity" />
        <activity
            android:name="com.helirfid.SectorSelectActivity"
            android:exported="true"
            android:parentActivityName="com.helirfid.ToolsActivity" />
        <activity
            android:name="com.helirfid.VerifyActivity"
            android:exported="true"
            android:parentActivityName="com.helirfid.ToolsActivity" />
        <activity
            android:name="com.helirfid.TraceViewerActivity"
            android:exported="true"
            android:parentActivityName="com.helirfid.ToolsActivity" />
        <activity
            android:name="com.helirfid.KeyRecoveryActivity"
            android:exported="true"
            android:parentActivityName="com.helirfid.ToolsActivity" />
        <activity
            android:name="com.helirfid.Acr122uActivity"
            android:exported="true"
            android:parentActivityName="com.helirfid.ToolsActivity" >
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>

            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />
        </activity>
        <activity
            android:name="com.helirfid.AccessDecoderActivity"
            android:exported="true"
            android:parentActivityName="com.helirfid.ToolsActivity" />
        <activity
            android:name="com.helirfid.DumpAsciiActivity"
            android:exported="true"
            android:parentActivityName="com.helirfid.ToolsActivity" />
        <activity
            android:name="com.helirfid.DumpHighlightActivity"
            android:exported="true"
            android:parentActivityName="com.helirfid.ToolsActivity" />
        <activity
            android:name="com.helirfid.ValueCodecActivity"
            android:exported="true"
            android:parentActivityName="com.helirfid.ToolsActivity" />
        <activity
            android:name="com.helirfid.NtagActivity"
            android:exported="true"
            android:parentActivityName="com.helirfid.ToolsActivity" />
        <activity
            android:name="com.helirfid.TagFormatActivity"
            android:exported="true"
            android:parentActivityName="com.helirfid.ToolsActivity" />
        <activity
            android:name="com.helirfid.AuthMapActivity"
            android:exported="true"
            android:parentActivityName="com.helirfid.ToolsActivity" />
        <activity
            android:name="com.helirfid.NfcPollerActivity"
            android:exported="true"
            android:parentActivityName="com.helirfid.ToolsActivity" />
        <activity
            android:name="com.helirfid.EmvCardActivity"
            android:exported="true"
            android:parentActivityName="com.helirfid.ToolsActivity" />
        <activity
            android:name="com.helirfid.WriteBlock0Activity"
            android:exported="true"
            android:parentActivityName="com.helirfid.ToolsActivity" />
        <activity
            android:name="com.helirfid.NfcMonitorActivity"
            android:exported="true"
            android:parentActivityName="com.helirfid.ToolsActivity" />
        <activity
            android:name="com.helirfid.CardFingerprintActivity"
            android:exported="true"
            android:parentActivityName="com.helirfid.ToolsActivity" />
        <activity
            android:name="com.helirfid.HelpActivity"
            android:exported="true"
            android:parentActivityName="com.helirfid.MainActivity" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.helirfid.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true" >
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="com.helirfid.androidx-startup"
            android:exported="false" >
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.profileinstaller.ProfileInstallerInitializer"
                android:value="androidx.startup" />
        </provider>

        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:directBootAware="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP" >
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SKIP_FILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SAVE_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.BENCHMARK_OPERATION" />
            </intent-filter>
        </receiver>
    </application>

</manifest>