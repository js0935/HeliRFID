<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1a1a2e">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="報表匯出"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_gravity="center"
            android:layout_marginBottom="20dp"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardElevation="4dp"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="#16213e"
            app:strokeColor="#0f3460"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="資料報表操作"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"/>

                <TextView
                    android:id="@+id/txtReportStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="請選擇匯出或匯入操作"
                    android:textSize="14sp"
                    android:textColor="#AAAAAA"
                    android:layout_marginTop="12dp"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReportCsv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="匯出 CSV 日誌"
            android:layout_marginBottom="8dp"
            app:backgroundTint="@color/btn_blue"
            app:cornerRadius="8dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReportCsvImport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="匯入 CSV 批次"
            android:layout_marginBottom="8dp"
            app:backgroundTint="@color/btn_green"
            app:cornerRadius="8dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReportHours"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="工時報表"
            app:backgroundTint="@color/btn_purple"
            app:cornerRadius="8dp"/>

    </LinearLayout>

</ScrollView>
