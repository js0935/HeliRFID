<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12dp">

    <TextView
        android:text="HCE 標籤模擬"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_gravity="center"
        android:layout_marginBottom="6dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        android:text=" 掃描 NFC 卡片"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/text_highlight"
        android:layout_marginBottom="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/txtHceScanStatus"
        android:text="請將 NFC 卡片靠近手機背面"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:textColor="@color/text_body"
        android:background="@color/card_bg"
        android:padding="10dp"
        android:layout_marginBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minLines="4"/>

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp">

        <EditText
            android:id="@+id/editHceCardName"
            android:hint="輸入卡片名稱..."
            android:inputType="text"
            android:textSize="13sp"
            android:textColor="@color/text_body"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"/>

        <Button
            android:id="@+id/btnHceSave"
            android:text="儲存"
            android:textSize="12sp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:backgroundTint="@color/btn_green"/>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#33FFFFFF"
        android:layout_marginVertical="4dp"/>

    <TextView
        android:text=" 已儲存卡片"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/text_highlight"
        android:layout_marginBottom="2dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <ListView
        android:id="@+id/listHceCards"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="40dp"
        android:background="@color/card_bg"
        android:layout_marginBottom="4dp"/>

    <Button
        android:id="@+id/btnHceDelete"
        android:text="刪除選取卡片"
        android:textSize="12sp"
        android:enabled="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginBottom="4dp"
        android:backgroundTint="@color/btn_red"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#33FFFFFF"
        android:layout_marginVertical="4dp"/>

    <TextView
        android:text=" 卡模擬"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/text_highlight"
        android:layout_marginBottom="2dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/txtHceSimStatus"
        android:text="未選擇模擬卡片"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:textColor="@color/text_body"
        android:background="@color/card_bg"
        android:padding="10dp"
        android:layout_marginBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minLines="2"/>

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp">

        <Button
            android:id="@+id/btnHceStart"
            android:text="啟動模擬"
            android:textSize="13sp"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/btn_green"/>

        <Button
            android:id="@+id/btnHceStop"
            android:text="停止模擬"
            android:textSize="13sp"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/btn_red"/>

    </LinearLayout>

</LinearLayout>
