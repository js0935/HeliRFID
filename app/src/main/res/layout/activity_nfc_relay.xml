<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NFC Relay 中繼攻擊工具"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="將 NFC 卡片資料透過網路中繼到遠端裝置模擬"
            android:textSize="12sp"
            android:textColor="#888"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <EditText android:id="@+id/editRelayIp"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="2" android:hint="伺服器 IP"
                android:inputType="text" android:layout_marginEnd="4dp" />
            <EditText android:id="@+id/editRelayPort"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:hint="Port"
                android:inputType="number" android:layout_marginStart="4dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">
            <Button android:id="@+id/btnRelayServer"
                android:layout_width="0dp" android:layout_height="48dp"
                android:layout_weight="1" android:text="啟動伺服器"
                android:layout_marginEnd="4dp" />
            <Button android:id="@+id/btnRelayReader"
                android:layout_width="0dp" android:layout_height="48dp"
                android:layout_weight="1" android:text="Reader 模式"
                android:layout_marginStart="2dp" android:layout_marginEnd="2dp" />
            <Button android:id="@+id/btnRelayTag"
                android:layout_width="0dp" android:layout_height="48dp"
                android:layout_weight="1" android:text="Tag 模式"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <Button android:id="@+id/btnRelayStop"
            android:layout_width="match_parent" android:layout_height="40dp"
            android:text="停止" android:layout_marginTop="4dp" />

        <TextView android:id="@+id/txtRelayStatus"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="狀態: 就緒"
            android:background="#1E000000" android:padding="6dp"
            android:textSize="12sp" android:typeface="monospace" />

        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="紀錄:" android:layout_marginTop="8dp"
            android:textSize="12sp" android:textStyle="bold" />

        <TextView android:id="@+id/txtRelayLog"
            android:layout_width="match_parent" android:layout_height="300dp"
            android:background="#1E000000" android:padding="6dp"
            android:textSize="10sp" android:typeface="monospace"
            android:scrollbars="vertical" />

    </LinearLayout>

</ScrollView>
