<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FeliCa 完整讀寫工具"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="支援 Sony FeliCa / NFC-F 卡片"
            android:textSize="12sp"
            android:textColor="#888"
            android:layout_marginBottom="8dp" />

        <TextView android:id="@+id/txtFelicaInfo"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="請掃描 FeliCa 卡片"
            android:background="#1E000000" android:padding="8dp"
            android:textSize="12sp" android:typeface="monospace" />

        <Button android:id="@+id/btnFelicaPoll"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:text="Polling (感應查詢)" android:layout_marginTop="8dp" />

        <Button android:id="@+id/btnFelicaGetSystemCode"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:text="取得 System Code" android:layout_marginTop="4dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Service Code (hex, 如 0009)" android:layout_marginTop="8dp" />
        <EditText android:id="@+id/editFelicaService"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="0009" android:inputType="text"
            android:maxLength="4" android:fontFamily="monospace" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="區塊號碼" android:layout_marginTop="4dp" />
        <EditText android:id="@+id/editFelicaBlock"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="0" android:inputType="number" />

        <Button android:id="@+id/btnFelicaReadBlock"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:text="讀取區塊" android:layout_marginTop="4dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="寫入資料 (32 hex)" android:layout_marginTop="4dp" />
        <EditText android:id="@+id/editFelicaWriteData"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="16 bytes hex, 32 字元" android:inputType="text"
            android:fontFamily="monospace" android:maxLength="32" />

        <Button android:id="@+id/btnFelicaWriteBlock"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:text="寫入區塊" android:layout_marginTop="4dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="結果:" android:layout_marginTop="8dp" />

        <TextView android:id="@+id/txtFelicaResult"
            android:layout_width="match_parent" android:layout_height="300dp"
            android:background="#1E000000" android:padding="6dp"
            android:textSize="10sp" android:typeface="monospace"
            android:scrollbars="vertical" />

    </LinearLayout>

</ScrollView>
