<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:text="金鑰恢復工具"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_gravity="center"
        android:layout_marginBottom="12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/txtKeyRecoveryStatus"
        android:text="請掃描 MIFARE Classic 卡片"
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:padding="8dp"
        android:background="#0A000000"
        android:layout_marginBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <TextView
        android:text="暴力破解模式 (選填，?? = 未知 1 byte)"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <EditText
        android:id="@+id/editBrutePattern"
        android:hint="例: FF ?? FF FF FF FF FF FF FF FF FF FF"
        android:inputType="text"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:textColor="@color/text_body"
        android:singleLine="true"
        android:layout_marginBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/txtKeyRecoveryResult"
        android:text=""
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:textColor="@color/text_body"
        android:lineSpacingExtra="2dp"
        android:padding="8dp"
        android:background="#1A000000"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <Button
        android:id="@+id/btnSaveRecoveredKeys"
        android:text="儲存恢復的金鑰"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:backgroundTint="@color/btn_green"
        android:enabled="false"/>

</LinearLayout>
