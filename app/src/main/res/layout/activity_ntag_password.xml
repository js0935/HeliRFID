<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NTAG 密碼保護與鎖定"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="支援 NTAG 213 / 215 / 216 系列"
            android:textSize="12sp"
            android:textColor="#888"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="設定密碼 (PWD)"
            android:textSize="14sp"
            android:textStyle="bold" />
        <EditText android:id="@+id/editNtagPwd"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="8 hex 字元 (例: 00000000)" android:inputType="text"
            android:maxLength="8" android:fontFamily="monospace" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="密碼確認碼 (PACK)"
            android:textSize="14sp"
            android:textStyle="bold" android:layout_marginTop="8dp" />
        <EditText android:id="@+id/editNtagPack"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="4 hex 字元 (例: 0000)" android:inputType="text"
            android:maxLength="4" android:fontFamily="monospace" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="保護起始頁 (AUTH0)"
            android:textSize="14sp"
            android:textStyle="bold" android:layout_marginTop="8dp" />
        <EditText android:id="@+id/editNtagAuth0"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="0-255 (設 1 表示頁面 1 起須密碼)" android:inputType="number"
            android:fontFamily="monospace" />

        <Button android:id="@+id/btnNtagSetPwd"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:text="設定密碼保護" android:layout_marginTop="8dp" />

        <Button android:id="@+id/btnNtagLockTag"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:text="永久鎖定標籤 (唯讀)" android:layout_marginTop="4dp" />

        <Button android:id="@+id/btnNtagCheckProt"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:text="檢查保護狀態" android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="注意: 鎖定為不可逆操作"
            android:textSize="11sp" android:textColor="#FF6600"
            android:layout_marginTop="4dp" />

        <TextView android:id="@+id/txtNtagPwdResult"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#1E000000" android:padding="8dp"
            android:textSize="11sp" android:typeface="monospace"
            android:minLines="8" />

    </LinearLayout>

</ScrollView>
