<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:text="ACR122U 外接讀卡器"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_gravity="center"
        android:layout_marginBottom="12dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/txtAcrInfo"
        android:text="請連接 ACR122U 讀卡器"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        android:background="@color/card_bg"
        android:padding="8dp"
        android:layout_marginBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnAcrConnect"
            android:text="連線"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/btn_green"/>

        <Button
            android:id="@+id/btnAcrDisconnect"
            android:text="斷線"
            android:enabled="false"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/btn_red"/>

    </LinearLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:hint="金鑰 A (12 hex, 預設 FFFFFFFFFFFF)">

        <EditText
            android:id="@+id/editAcrKeyA"
            android:text="FFFFFFFFFFFF"
            android:inputType="text"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:textColor="@color/text_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:hint="Sector 編號 (0-15)">

        <EditText
            android:id="@+id/editAcrSector"
            android:text="0"
            android:inputType="number"
            android:textSize="14sp"
            android:textColor="@color/text_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnAcrGetUid"
            android:text="讀取 UID"
            android:enabled="false"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/btn_blue"/>

        <Button
            android:id="@+id/btnAcrReadSector"
            android:text="讀取 Sector"
            android:enabled="false"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/btn_purple"/>

        <Button
            android:id="@+id/btnAcrFullDump"
            android:text="完整轉儲"
            android:enabled="false"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/btn_orange"/>

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/card_bg"
        android:padding="8dp">

        <TextView
            android:id="@+id/txtAcrResult"
            android:text=""
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:textColor="@color/text_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

    </ScrollView>

</LinearLayout>
