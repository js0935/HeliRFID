<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NDEF 編輯器"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <Spinner
            android:id="@+id/spinnerNdefType"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp" />

        <!-- Text -->
        <LinearLayout android:id="@+id/layoutNdefText"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:visibility="visible">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="文字內容" />
            <EditText android:id="@+id/editNdefText"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="請輸入文字..." android:inputType="textMultiLine"
                android:minLines="3" />
        </LinearLayout>

        <!-- URL -->
        <LinearLayout android:id="@+id/layoutNdefUrl"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:visibility="gone">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="網址 URL" />
            <EditText android:id="@+id/editNdefUrl"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="https://example.com" android:inputType="textUri" />
        </LinearLayout>

        <!-- Email -->
        <LinearLayout android:id="@+id/layoutNdefEmail"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:visibility="gone">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="收件人" />
            <EditText android:id="@+id/editNdefEmailTo"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="email@example.com" android:inputType="textEmailAddress" />
            <Button android:id="@+id/btnContactPickEmail"
                android:layout_width="match_parent" android:layout_height="36dp"
                android:text="從聯絡人選取" android:textSize="12sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="主旨" />
            <EditText android:id="@+id/editNdefEmailSubj"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="主旨" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="內容" />
            <EditText android:id="@+id/editNdefEmailBody"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="郵件內容" android:inputType="textMultiLine"
                android:minLines="2" />
        </LinearLayout>

        <!-- Phone -->
        <LinearLayout android:id="@+id/layoutNdefPhone"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:visibility="gone">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="電話號碼" />
            <EditText android:id="@+id/editNdefPhone"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="+886912345678" android:inputType="phone" />
            <Button android:id="@+id/btnContactPickPhone"
                android:layout_width="match_parent" android:layout_height="36dp"
                android:text="從聯絡人選取" android:textSize="12sp" />
        </LinearLayout>

        <!-- SMS -->
        <LinearLayout android:id="@+id/layoutNdefSms"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:visibility="gone">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="號碼" />
            <EditText android:id="@+id/editNdefSmsNum"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="+886912345678" android:inputType="phone" />
            <Button android:id="@+id/btnContactPickSms"
                android:layout_width="match_parent" android:layout_height="36dp"
                android:text="從聯絡人選取" android:textSize="12sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="訊息" />
            <EditText android:id="@+id/editNdefSmsMsg"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="簡訊內容" android:inputType="textMultiLine"
                android:minLines="2" />
        </LinearLayout>

        <!-- WiFi -->
        <LinearLayout android:id="@+id/layoutNdefWifi"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:visibility="gone">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="SSID (WiFi 名稱)" />
            <EditText android:id="@+id/editNdefSsid"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="MyWiFi" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="密碼" />
            <EditText android:id="@+id/editNdefWifiPwd"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="密碼" android:inputType="textPassword" />
        </LinearLayout>

        <!-- vCard -->
        <LinearLayout android:id="@+id/layoutNdefVCard"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:visibility="gone">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="姓名" />
            <EditText android:id="@+id/editNdefVCardName"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="王小明" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="電話" />
            <EditText android:id="@+id/editNdefVCardPhone"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="+886912345678" android:inputType="phone" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Email" />
            <EditText android:id="@+id/editNdefVCardEmail"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="email@example.com" android:inputType="textEmailAddress" />
            <Button android:id="@+id/btnContactPickVCard"
                android:layout_width="match_parent" android:layout_height="36dp"
                android:text="從聯絡人選取 (姓名/電話/Email)" android:textSize="12sp" />
        </LinearLayout>

        <!-- Geo -->
        <LinearLayout android:id="@+id/layoutNdefGeo"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:visibility="gone">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="緯度" />
                <EditText android:id="@+id/editNdefLat"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="25.0330" android:inputType="numberDecimal" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical"
                android:layout_marginStart="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="經度" />
                <EditText android:id="@+id/editNdefLng"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:hint="121.5654" android:inputType="numberDecimal" />
            </LinearLayout>
        </LinearLayout>

        <!-- Bluetooth -->
        <LinearLayout android:id="@+id/layoutNdefBt"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:visibility="gone">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="藍牙 MAC 位址" />
            <EditText android:id="@+id/editNdefBtMac"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="00:11:22:33:44:55" android:inputType="text" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="裝置名稱 (選填)" />
            <EditText android:id="@+id/editNdefBtName"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="My Headset" />
        </LinearLayout>

        <!-- Smart Poster -->
        <LinearLayout android:id="@+id/layoutNdefSmartPoster"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:visibility="gone">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Smart Poster 標題" />
            <EditText android:id="@+id/editNdefSpTitle"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="標題文字" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Smart Poster URL" />
            <EditText android:id="@+id/editNdefSpUrl"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="https://example.com" android:inputType="textUri" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="動作 (0=執行 1=儲存 2=編輯)" />
            <EditText android:id="@+id/editNdefSpAction"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="0" android:inputType="number" />
        </LinearLayout>

        <!-- AAR -->
        <LinearLayout android:id="@+id/layoutNdefAar"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:visibility="gone">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Android App 套件名稱" />
            <EditText android:id="@+id/editNdefAarPkg"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="com.helirfid" />
        </LinearLayout>

        <!-- ICE Emergency Contact -->
        <LinearLayout android:id="@+id/layoutNdefIce"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:visibility="gone">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="ICE 急難聯絡人 - 姓名" />
            <EditText android:id="@+id/editNdefIceName"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="王小明" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="電話" />
            <EditText android:id="@+id/editNdefIcePhone"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="+886912345678" android:inputType="phone" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Email" />
            <EditText android:id="@+id/editNdefIceEmail"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="email@example.com" android:inputType="textEmailAddress" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="關係 (選填)" />
            <EditText android:id="@+id/editNdefIceRelation"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="家人/朋友/配偶" />
            <Button android:id="@+id/btnContactPickIce"
                android:layout_width="match_parent" android:layout_height="36dp"
                android:text="從聯絡人選取 (姓名/電話)" android:textSize="12sp" />
        </LinearLayout>

        <!-- Custom Data -->
        <LinearLayout android:id="@+id/layoutNdefCustom"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:visibility="gone">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="TNF 類型" />
            <Spinner android:id="@+id/spinnerNdefCustomTnf"
                android:layout_width="match_parent" android:layout_height="48dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="類型字串 (Type)" android:layout_marginTop="4dp" />
            <EditText android:id="@+id/editNdefCustomType"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="例如: com.example:type" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Payload (hex 字串)" android:layout_marginTop="4dp" />
            <EditText android:id="@+id/editNdefCustomData"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="48656C6C6F" android:fontFamily="monospace" />
        </LinearLayout>

        <!-- WiFi WSC (Simple Config) -->
        <LinearLayout android:id="@+id/layoutNdefWsc"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:visibility="gone">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="WiFi WSC (Simple Config) - SSID" />
            <EditText android:id="@+id/editNdefWscSsid"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="WiFi 名稱" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="密碼" />
            <EditText android:id="@+id/editNdefWscPwd"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="密碼" android:inputType="textPassword" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="驗證類型" />
            <Spinner android:id="@+id/spinnerNdefWscAuth"
                android:layout_width="match_parent" android:layout_height="48dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="加密類型" />
            <Spinner android:id="@+id/spinnerNdefWscEncrypt"
                android:layout_width="match_parent" android:layout_height="48dp" />
        </LinearLayout>

        <!-- Bitcoin / Cryptocurrency -->
        <LinearLayout android:id="@+id/layoutNdefBitcoin"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:visibility="gone">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="比特幣/加密貨幣 (Bitcoin)" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="比特幣地址" android:layout_marginTop="4dp" />
            <EditText android:id="@+id/editNdefBtcAddress"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="1A1zP1eP5QGefi2DMPTfTL5SLmv7DivfNa" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="金額 (選填)" android:layout_marginTop="4dp" />
            <EditText android:id="@+id/editNdefBtcAmount"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="0.01" android:inputType="numberDecimal" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="標籤 (選填)" android:layout_marginTop="4dp" />
            <EditText android:id="@+id/editNdefBtcLabel"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="Donation" />
        </LinearLayout>

        <!-- Social Network -->
        <LinearLayout android:id="@+id/layoutNdefSocial"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:visibility="gone">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="社群網路 (Facebook/Twitter/IG)" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="平台" android:layout_marginTop="4dp" />
            <Spinner android:id="@+id/spinnerNdefSocialPlatform"
                android:layout_width="match_parent" android:layout_height="48dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="使用者名稱/ID" android:layout_marginTop="4dp" />
            <EditText android:id="@+id/editNdefSocialHandle"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="username" />
        </LinearLayout>

        <!-- Messenger -->
        <LinearLayout android:id="@+id/layoutNdefMessenger"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:visibility="gone">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="LINE/WhatsApp/Telegram" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="類型" android:layout_marginTop="4dp" />
            <Spinner android:id="@+id/spinnerNdefMessengerType"
                android:layout_width="match_parent" android:layout_height="48dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="ID/號碼" android:layout_marginTop="4dp" />
            <EditText android:id="@+id/editNdefMessengerId"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="LINE ID 或電話號碼" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">
            <Button android:id="@+id/btnNdefWrite"
                android:layout_width="0dp" android:layout_height="48dp"
                android:layout_weight="1" android:text="寫入"
                android:layout_marginEnd="4dp" />
            <Button android:id="@+id/btnNdefRead"
                android:layout_width="0dp" android:layout_height="48dp"
                android:layout_weight="1" android:text="讀取"
                android:layout_marginStart="4dp" />
        </LinearLayout>
        <Button android:id="@+id/btnNdefClear"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:text="清除 NDEF (TNF_EMPTY)"
            android:layout_marginTop="4dp" />

        <TextView android:id="@+id/txtNdefInfo"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="等待 NFC 卡片..."
            android:background="#1E000000"
            android:padding="8dp"
            android:textSize="12sp" />

        <TextView android:id="@+id/txtNdefResult"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#1E000000"
            android:padding="8dp"
            android:textSize="12sp"
            android:minLines="4" />

    </LinearLayout>

</ScrollView>
