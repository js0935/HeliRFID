<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="檔案操作任務"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="執行各類檔案操作 (支援動態變數 %FILES_DIR%, %CACHE_DIR%, %EXT_STORAGE%)"
            android:textSize="12sp"
            android:textColor="#888"
            android:layout_marginBottom="8dp" />

        <Spinner android:id="@+id/spinnerFileOp"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <EditText android:id="@+id/editFileParam1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="參數 1 (路徑/來源)"
            android:layout_marginTop="4dp" />

        <EditText android:id="@+id/editFileParam2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="參數 2 (目的地/內容)"
            android:minLines="2"
            android:visibility="gone" />

        <Button android:id="@+id/btnFileExecute"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="執行操作"
            android:layout_marginTop="8dp" />

        <TextView android:id="@+id/txtFileResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#1E000000"
            android:padding="8dp"
            android:textSize="12sp"
            android:typeface="monospace"
            android:minLines="4"
            android:text="就緒" />

    </LinearLayout>
</ScrollView>
