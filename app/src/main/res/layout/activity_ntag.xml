<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:text="NTAG 讀寫器"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_gravity="center"
            android:layout_marginBottom="12dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <TextView
            android:text="支援 NTAG 21x / MIFARE Ultralight 系列卡片"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <Button
            android:id="@+id/btnNtagRead"
            android:text="📖 等待卡片掃描..."
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:backgroundTint="@color/btn_blue"/>

        <EditText
            android:id="@+id/editNdefPayload"
            android:hint="NDEF 資料 (非 NDEF 指令寫入測試)"
            android:inputType="text"
            android:textSize="12sp"
            android:textColor="@color/text_body"
            android:minLines="2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnNtagWriteNdef"
            android:text="寫入 NDEF"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:backgroundTint="@color/btn_orange"/>

        <Button
            android:id="@+id/btnNtagClear"
            android:text="清除"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:backgroundTint="@color/btn_red"/>

        <TextView
            android:id="@+id/txtNtagResult"
            android:text=""
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:textColor="@color/text_body"
            android:lineSpacingExtra="2dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

    </LinearLayout>

</ScrollView>
